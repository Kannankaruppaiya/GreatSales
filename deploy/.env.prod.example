# Template for /opt/greatsales/.env on the production box.
#
# The real file is GENERATED ON THE BOX by scripts/deploy-aws.mjs with mode 600
# and random secrets. It is never committed and never passed through a command
# line. Copy this only if you are provisioning by hand.
#
# AWS Secrets Manager is the right long-term home for these; a 600 file on a
# single box is the interim, and moving requires an IAM policy on the instance
# role rather than a change to the application.

# Postgres OWNER password — used by migrations only.
POSTGRES_PASSWORD=

# Password for greatsales_app, the RLS-bound role the API connects as.
# The RLS migration creates this role with the literal password
# 'greatsales_app'; deploy rotates it immediately after migrating.
APP_DB_PASSWORD=

# Two DIFFERENT secrets, 32+ chars each. The env contract rejects a shared
# secret because an access token could then be replayed as a refresh token.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Exact browser origin(s). Never "*" — the contract refuses to boot on it.
CORS_ORIGIN=https://your-domain.example

# ":80" serves plain HTTP on the IP (no certificate possible without a name).
# Set a hostname and Caddy provisions and renews TLS by itself.
SITE_ADDRESS=:80

# Optional. Without it a production crash is invisible until a user reports it.
SENTRY_DSN=

# Attachments / Object Storage (required in production)
STORAGE_DRIVER=s3
S3_BUCKET=greatsales-attachments-887793660359-euw2
S3_REGION=eu-west-2

IMAGE_TAG=latest

