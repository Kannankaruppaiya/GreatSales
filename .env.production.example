# =============================================================================
# GreatSales — PRODUCTION environment template  (AWS)
# =============================================================================
# THIS FILE IS A SHAPE, NOT A CONFIGURATION.
#
# In production there is no .env file on disk. Every value below is injected as
# an environment variable by the platform, sourced from AWS Secrets Manager /
# SSM Parameter Store and referenced by the ECS task definition. A secret that
# lands in a file lands in an image layer, a backup, and eventually a laptop.
#
# Every value below is a REPLACE_ME placeholder that is structurally valid, so
# this template can itself be validated (see below) — but nothing here is real,
# and the comment above each entry names the secrets-manager key that is.
#
# Validate a candidate production environment before deploying:
#     pnpm --filter api env:check <file> --as production
#
# The authoritative contract is apps/api/src/config/env.ts. Production rules
# there are enforced at boot: a misconfigured task fails fast and never serves
# traffic. See checklists/11-BUILD-INFRA.md and checklists/07-SECURITY.md.
# =============================================================================

NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# DATABASE_URL must be the RLS-BOUND role (greatsales_app), non-superuser and
# NOBYPASSRLS. PrismaService checks the live connection at boot and refuses to
# start otherwise — see checklists/01-DATABASE.md A.3.1.
#
# Route the API through RDS Proxy for connection pooling. Set connection_limit
# deliberately: pool x task-count must stay under the instance max_connections.
# Real value: secrets manager entry  greatsales/prod/DATABASE_URL
DATABASE_URL="postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE-proxy.proxy-xxxx.ap-south-1.rds.amazonaws.com:5432/greatsales?schema=public&connection_limit=10"

# The OWNER url, used ONLY by the migration job (a one-off ECS task running
# `prisma migrate deploy`), never by the serving tasks. Migrations must NOT go
# through a transaction pooler, so this points at the instance directly.
# The env contract rejects a production boot where this equals DATABASE_URL.
# Real value: secrets manager entry  greatsales/prod/DIRECT_URL
DIRECT_URL="postgresql://REPLACE_OWNER:REPLACE_PASSWORD@REPLACE.xxxx.ap-south-1.rds.amazonaws.com:5432/greatsales?schema=public"

# -----------------------------------------------------------------------------
# JWT — rotate on a schedule; see checklists/07-SECURITY.md G.1.15
# -----------------------------------------------------------------------------
# Both are REQUIRED to be >= 32 characters and DIFFERENT from each other.
#     openssl rand -base64 48
# Real values: greatsales/prod/JWT_ACCESS_SECRET and .../JWT_REFRESH_SECRET
JWT_ACCESS_SECRET="REPLACE_ME_openssl_rand_base64_48_access_xxxxxxxxxxxx"
JWT_REFRESH_SECRET="REPLACE_ME_openssl_rand_base64_48_refresh_xxxxxxxxxxx"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# -----------------------------------------------------------------------------
# Origins — subdomain per tenant
# -----------------------------------------------------------------------------
# DECISION (2026-08-25): tenants are addressed as
# `<tenant>.app.greatsales.<tld>` (FEATURE-ROADMAP F1 option A). The user never
# types a tenant id, which closes the D9 enumeration surface, and the API stays
# same-origin with the web console so the refresh cookie remains first-party.
#
# Requires: a Route53 wildcard record and an ACM WILDCARD certificate
# (*.app.greatsales.<tld>) on the CloudFront distribution / ALB listener.
#
# Because a new tenant must work without a redeploy, the allow-list cannot be
# enumerated: CORS_ORIGIN_SUFFIX matches the parsed hostname over https only.
CORS_ORIGIN="https://app.greatsales.example"
CORS_ORIGIN_SUFFIX=".app.greatsales.example"
APP_BASE_DOMAIN="app.greatsales.example"

# -----------------------------------------------------------------------------
# Proxy
# -----------------------------------------------------------------------------
# CloudFront -> ALB -> task. Set the real hop count; production refuses
# "false". Wrong here means one shared rate-limit bucket for the whole internet
# and an audit trail full of the load balancer's address.
TRUST_PROXY="2"

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
# Production REFUSES "true". The explorer enumerates every endpoint.
SWAGGER_ENABLED="false"

LOG_LEVEL="info"

# Real value: secrets manager entry  greatsales/prod/SENTRY_DSN
SENTRY_DSN="https://REPLACE_ME@o0.ingest.sentry.io/0"

# Optional TODAY (no API code consumes it yet). This becomes REQUIRED in
# production the moment the rate limiter moves off in-process storage — with
# more than one ECS task the current limit is multiplied by the task count.
# See checklists/03-API.md C.1.13.
# REDIS_URL="redis://REPLACE.cache.amazonaws.com:6379"   (greatsales/prod/REDIS_URL)

# =============================================================================
# NOT SET HERE, ON PURPOSE
# =============================================================================
# VITE_*        The web console is a static build. Its configuration is BAKED
#               IN at `vite build` time via Docker build args, so production
#               needs its OWN image — a staging image cannot be promoted
#               unchanged. See checklists/11-BUILD-INFRA.md K.1.3.
#
# VITE_DEMO_*   Login prefill. Never set in any real environment.
#               apps/web/src/lib/config.ts forces these empty in a production
#               build regardless, but do not rely on that alone.
#
# EXPO_PUBLIC_* Mobile configuration lives in EAS build profiles, not here.
