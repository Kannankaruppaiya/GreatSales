{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "api",
        "start:dev"
      ],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "mobilev2-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@greatsales/mobilev2",
        "web",
        "--port",
        "8082"
      ],
      "port": 8082,
      "env": {
        "EXPO_NO_DEPENDENCY_VALIDATION": "1"
      }
    }
  ]
}
