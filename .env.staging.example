# GreatSales Staging Environment Configuration Template
NODE_ENV=staging
PORT=3000

# Database URLs (Container Network)
DATABASE_URL="postgresql://greatsales_app:greatsales_app@postgres:5432/greatsales?schema=public"
DIRECT_URL="postgresql://greatsales:greatsales@postgres:5432/greatsales?schema=public"

# Staging Cryptographic Secrets (Min 32 characters entropy)
JWT_ACCESS_SECRET="staging-jwt-access-secret-32-chars-minimum-entropy!"
JWT_REFRESH_SECRET="staging-jwt-refresh-secret-32-chars-minimum-entropy!"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Redis & Queues.
# NOTE: provisioned by docker-compose.staging.yml but NOT yet consumed by the
# API — it is declared optional in apps/api/src/config/env.ts for exactly that
# reason. It becomes required in production once the rate limiter moves off
# in-process storage (today's limit is PER INSTANCE) or when jobs land.
REDIS_URL="redis://redis:6379"

# Web Client Settings
# Same-origin by design: the refresh token is an httpOnly, SameSite=Lax cookie
# scoped to /api/v1/auth. Serving the API under the web app's own origin keeps
# it a FIRST-party cookie. A cross-site setup would need SameSite=None, which
# browsers increasingly block — do not split the origins.
VITE_API_URL="/api/v1"
VITE_APP_ENV="staging"
VITE_APP_NAME="GreatSales Staging"

# Credentialed CORS forbids a wildcard: the API refuses to boot with "*" unless
# NODE_ENV=development. List the exact origin(s), comma-separated.
CORS_ORIGIN="https://staging.greatsales.example"

# Express `trust proxy`. The API sits behind a reverse proxy here, so without
# this every client shares one rate-limit bucket and User.lastIp records the
# proxy. Use the number of proxy hops in front of the API ("1"), or "loopback".
TRUST_PROXY="1"

# Origin suffix for subdomain-per-tenant. Staging normally runs a single host,
# so leave empty and rely on the exact CORS_ORIGIN above. Set both only when
# staging is exercising the wildcard-DNS topology that production uses.
CORS_ORIGIN_SUFFIX=""
APP_BASE_DOMAIN=""

# OpenAPI explorer at /api/docs. Useful on staging, refused in production.
SWAGGER_ENABLED="true"

# error | warn | info | debug | verbose
LOG_LEVEL="info"

# Error tracking. Point staging at its OWN Sentry project, never production's.
# SENTRY_DSN=""

# NOTE: demo login prefill (VITE_DEMO_*) is intentionally absent. A production
# build forces it empty regardless (apps/web/src/lib/config.ts).
