# GreatSales Staging Environment Configuration Template
NODE_ENV=staging
PORT=3000

# Database URLs (Container Network)
DATABASE_URL="postgresql://greatsales_app:greatsales_app@postgres:5432/greatsales?schema=public"
DIRECT_URL="postgresql://greatsales:greatsales@postgres:5432/greatsales?schema=public"

# Staging Cryptographic Secrets (Min 32 characters entropy)
JWT_ACCESS_SECRET="staging-jwt-access-secret-32-chars-minimum-entropy!"
JWT_REFRESH_SECRET="staging-jwt-refresh-secret-32-chars-minimum-entropy!"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Redis & Queues
REDIS_URL="redis://redis:6379"

# Web Client Settings
VITE_API_URL="/api/v1"
VITE_APP_ENV="staging"
VITE_APP_NAME="GreatSales Staging"
CORS_ORIGIN="*"
