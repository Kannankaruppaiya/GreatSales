// GreatSales CRM — Prisma schema (PostgreSQL)
// Design source: DB-SCHEMA-CHECKLIST.md. All POC gaps filled.
// Conventions: cuid ids, tenantId on tenant-owned tables, soft-delete (deletedAt),
// timestamps, indexes on FKs + filter columns. RLS applied post-migration (SQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // direct connection for migrations (bypass pooler/RDS Proxy)
}

// ============================================================
// ENUMS
// ============================================================
enum CustomerCategory {
  Platinum
  Gold
  Silver
  Brass
}

enum PaymentTerms {
  Immediate
  Credit15
  Credit30
  Credit45
  CashOnDelivery
  Advance50Balance // "Advance 50% + Balance Delivery"
  AdvancePayment // 100% Advance Payment
}

// LUB / WES — which business line a record belongs to.
enum Division {
  LUB
  WES
}

// Customer/Lead classification.
enum CustomerType {
  Existing
  New
}

// New-sales pipeline stages (Lead.stage). 9 stages, mirrors frontend DEAL_STAGES.
enum DealStage {
  NewEnquiries
  NeedsAnalysis
  TrialsAndSampleTests
  ProposalsAndPriceQuote
  NegotiationOralConfirmation
  ClosedWon
  ClosedLost
  NoRequirementOrCold
  TrialProblem
}

// Recurring-projection line statuses (Projection.status). 13 values, mirrors
// frontend PROJ_STATUSES — distinct from the Lead DealStage pipeline.
enum ProjStatus {
  ProjectionCreated
  FollowUpPending
  CustomerInterested
  WaitingApproval
  POExpected
  POReceived
  OrderPlaced
  PartiallyConfirmed
  Confirmed
  Completed
  DeferredToNextMonth
  Lost
  Cancelled
}

// How goods move for a sales order (SalesOrder.deliveryMode).
enum DeliveryMode {
  TransportLR // Transport (LR)
  Courier
  CompanyVehicle
  CustomerPickup
  HandDelivery
}

enum LeadStatus {
  Platinum
  Gold
  Silver
  Bronze
}

enum PayZone {
  RedZone
  YellowZone
  GreenZone
  Blacklist
}

// Sales-order lifecycle (SalesOrder.status). 6 stages + Cancelled, mirrors
// frontend SO_STATUSES.
enum OrderStatus {
  Created
  Acknowledged
  DeliveryPartnerAssigned
  DeliveredFromWarehouse
  DeliveredToCustomer
  CustomerReceiptConfirmed
  Cancelled
}

enum PaymentStatus {
  Pending
  PartiallyPaid
  Paid
  Overdue
}

enum EntityType {
  Customer
  Lead
  Order
  Payment
  Projection
}

enum NotificationType {
  FollowUpDue
  PaymentReminder
  LeadAssigned
  CustomerAssigned
  OrderUpdate
  System
}

// Platform-layer enums (operator-side)
enum TenantStatus {
  Trial
  Active
  Suspended
  Churned
}

enum PlatformRole {
  SuperAdmin
  Ops
  Support
  Billing
  ReadOnly
}

// ============================================================
// 1. TENANT & ORG
// ============================================================
model Tenant {
  id               String       @id @default(cuid())
  name             String
  plan             String       @default("free")
  limits           Json         @default("{}")
  config           Json         @default("{}")
  status           TenantStatus @default(Trial)
  region           String? // data residency, e.g. "uk", "in", "us"
  industry         String? // tenant company's own industry (metadata)
  contractStart    DateTime?
  contractEnd      DateTime?
  accountManagerId String? // operator-side owner → PlatformUser
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  users         User[]
  teams         Team[]
  roles         Role[]
  customers     Customer[]
  principals    Principal[]
  products      Product[]
  mappings      Mapping[]
  salesTargets  SalesTarget[]
  projections   Projection[]
  leads         Lead[]
  salesOrders   SalesOrder[]
  payments      Payment[]
  followUps     FollowUp[]
  activities    Activity[]
  remarks       Remark[]
  notifications Notification[]
  attachments   Attachment[]
  auditLogs     AuditLog[]
  importJobs    ImportJob[]
  periodLocks   PeriodLock[]
  featureFlags  TenantFeatureFlag[]
  refreshTokens RefreshToken[]

  accountManager PlatformUser? @relation(fields: [accountManagerId], references: [id])

  @@index([deletedAt])
  @@index([status])
}

model User {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  email               String
  username            String
  passwordHash        String
  roleId              String
  managerId           String? // self-relation → reporting manager
  teamId              String?
  active              Boolean   @default(true)
  lastIp              String?
  lastLoginAt         DateTime?
  // Brute-force containment. Counter is authoritative across API instances
  // (per-IP throttling is per-instance and best-effort); reset on any success.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  /// Set when an ADMIN chooses this user's password (on create, or on reset).
  /// From that moment the credential is a shared secret, so the user must
  /// replace it before doing anything else. Enforced by MustChangePasswordGuard,
  /// not merely surfaced to the UI.
  mustChangePassword  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  role         Role   @relation(fields: [roleId], references: [id])
  manager      User?  @relation("UserManager", fields: [managerId], references: [id])
  reports      User[] @relation("UserManager")
  team         Team?  @relation("TeamMembers", fields: [teamId], references: [id])
  managedTeams Team[] @relation("TeamManager")

  customers               Customer[]
  collectorCustomers      Customer[]           @relation("CustomerCollector")
  pinnedCustomerLocations Customer[]           @relation("CustomerLocationPinnedBy")
  mappings                Mapping[]
  salesTargets            SalesTarget[]
  leads                   Lead[]
  salesOrders             SalesOrder[]
  createdOrders           SalesOrder[]         @relation("OrderCreatedBy")
  paymentsOwned           Payment[]            @relation("PaymentOwner")
  followUps               FollowUp[]
  activities              Activity[]
  remarks                 Remark[]
  periodLocks             PeriodLock[]
  notifications           Notification[]
  attachments             Attachment[]
  auditLogs               AuditLog[]
  orderStatusChanges      OrderStatusHistory[]
  refreshTokens           RefreshToken[]

  // Uniqueness is enforced by PARTIAL unique indexes created in the F12
  // migration: only rows with deletedAt IS NULL participate, so soft-deleting a
  // user frees their email and username for reuse. Prisma cannot express a
  // WHERE clause on @@unique, so these are plain indexes here and real
  // constraints in SQL. A violation still raises P2002.
  @@index([tenantId, email])
  @@index([tenantId, username])
  // Serves the default listing and its default `name asc` sort in one index.
  @@index([tenantId, deletedAt, name])
  @@index([tenantId])
  @@index([managerId])
  @@index([teamId])
  @@index([deletedAt])
}

/**
 * One issued refresh token. `id` IS the JWT `jti`, so a presented token is
 * looked up directly — a signature that verifies but has no row (or a revoked
 * row) is rejected.
 * `familyId` groups every token descended from one login. Rotation consumes a
 * token and issues its replacement in the same family; presenting an already
 * consumed token means the token was stolen and replayed, so the WHOLE family
 * is revoked. That is what makes a leaked refresh token containable.
 */
model RefreshToken {
  id            String    @id // = JWT jti
  tenantId      String
  userId        String
  familyId      String
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  usedAt        DateTime? // set when rotated; a second use = replay
  revokedAt     DateTime?
  revokedReason String?
  replacedById  String? // token issued in its place
  ip            String?
  userAgent     String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId]) // "revoke all sessions for this user"
  @@index([familyId]) // reuse detection revokes by family
  @@index([expiresAt]) // expiry sweep
}

model Team {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  managerId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  manager User   @relation("TeamManager", fields: [managerId], references: [id])
  members User[] @relation("TeamMembers")

  @@index([tenantId])
  @@index([managerId])
}

model Role {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id     String @id @default(cuid())
  key    String @unique // e.g. "customer.create"
  module String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ============================================================
// 2. CUSTOMERS
// ============================================================
model Industry {
  id            String     @id @default(cuid())
  name          String
  subIndustries Json       @default("[]")
  customers     Customer[]
}

model Customer {
  id            String            @id @default(cuid())
  tenantId      String
  name          String
  division      Division?
  category      CustomerCategory? // "tier" on the frontend
  type          CustomerType? // Existing | New
  industryId    String?
  subIndustry   String?
  area          String?
  paymentTerms  PaymentTerms?
  payZone       PayZone?
  outstanding   Decimal           @default(0) @db.Decimal(14, 2)
  active        Boolean           @default(true)
  salespersonId String
  collectorId   String? // payment collector (may differ from salesperson)

  // Where the customer physically is. Pinned on site from the salesperson's
  // GPS, because an `area` string is not something a driver can navigate to.
  // Accuracy is kept so a pin taken indoors can be told from one taken at the
  // gate, and the pinner so a wrong pin has an owner to ask.
  latitude           Decimal?  @db.Decimal(10, 7)
  longitude          Decimal?  @db.Decimal(10, 7)
  locationAccuracyM  Int?
  locationPinnedAt   DateTime?
  locationPinnedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  industry         Industry?         @relation(fields: [industryId], references: [id])
  salesperson      User              @relation(fields: [salespersonId], references: [id])
  collector        User?             @relation("CustomerCollector", fields: [collectorId], references: [id])
  locationPinnedBy User?             @relation("CustomerLocationPinnedBy", fields: [locationPinnedById], references: [id])
  contacts         CustomerContact[]
  mappings         Mapping[]
  salesOrders      SalesOrder[]
  payments         Payment[]

  @@index([tenantId])
  @@index([salespersonId])
  @@index([collectorId])
  @@index([category])
  @@index([deletedAt])
}

model CustomerContact {
  id           String   @id @default(cuid())
  customerId   String
  name         String
  designation  String?
  phone        String?
  mobile       String?
  whatsapp     String?
  sameAsMobile Boolean  @default(true)
  email        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

// ============================================================
// 3. PRODUCTS & PRINCIPALS
// ============================================================
model Principal {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  products     Product[]
  leadProducts LeadProduct[]

  @@index([tenantId])
}

model Product {
  id          String    @id @default(cuid())
  tenantId    String
  principalId String
  name        String
  sku         String?
  division    Division?
  unit        String?
  basePrice   Decimal?  @db.Decimal(14, 2) // "listPrice" on the frontend
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  principal    Principal        @relation(fields: [principalId], references: [id])
  mappings     Mapping[]
  orderItems   SalesOrderItem[]
  leadProducts LeadProduct[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([principalId])
}

model Mapping {
  id            String    @id @default(cuid())
  tenantId      String
  customerId    String
  productId     String
  salespersonId String
  customPrice   Decimal?  @db.Decimal(14, 2) // agreed price override for this customer×product
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  salesperson User         @relation(fields: [salespersonId], references: [id])
  projections Projection[]

  @@unique([customerId, productId])
  @@index([tenantId])
  @@index([salespersonId])
}

// ============================================================
// 4. TARGETS & PROJECTIONS (CORE)
// ============================================================
model SalesTarget {
  id            String   @id @default(cuid())
  tenantId      String
  salespersonId String
  period        String // YYYY-MM
  targetValue   Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  salesperson User   @relation(fields: [salespersonId], references: [id])

  @@unique([salespersonId, period])
  @@index([tenantId])
  @@index([period])
}

model Projection {
  id           String     @id @default(cuid())
  tenantId     String
  mappingId    String
  period       String // YYYY-MM ("month" on the frontend)
  committedQty Decimal    @default(0) @db.Decimal(14, 2) // "projectedQty" on the frontend
  achievedQty  Decimal    @default(0) @db.Decimal(14, 2)
  price        Decimal?   @db.Decimal(14, 2)
  customPrice  Decimal?   @db.Decimal(14, 2)
  probability  Int? // 0–100 win confidence (weighted pipeline)
  status       ProjStatus @default(ProjectionCreated)
  nextFollowUp DateTime?
  targetDate   DateTime?
  salesOrderId String? // linked SO once the projection converts
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  mapping    Mapping     @relation(fields: [mappingId], references: [id])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])

  @@unique([mappingId, period])
  @@index([tenantId])
  @@index([period])
  @@index([salesOrderId])
}

// ============================================================
// 5. LEADS (NEW SALES)
// ============================================================
model Lead {
  id             String            @id @default(cuid())
  tenantId       String
  customerName   String // "name" on the frontend
  division       Division?
  tier           CustomerCategory? // Platinum | Gold | Silver | Brass
  type           CustomerType? // Existing | New
  salespersonId  String
  stage          DealStage         @default(NewEnquiries)
  leadStatus     LeadStatus?
  industryId     String?
  subIndustry    String?
  area           String?
  address        String?
  contactName    String?
  phone          String?
  whatsapp       String?
  sameAsMobile   Boolean           @default(true)
  email          String?
  nextFollowUp   DateTime?
  expClose       DateTime? // expected close date
  stageUpdatedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  salesperson User           @relation(fields: [salespersonId], references: [id])
  products    LeadProduct[]
  activities  LeadActivity[]

  @@index([tenantId])
  @@index([salespersonId])
  @@index([stage])
}

model LeadProduct {
  id          String   @id @default(cuid())
  leadId      String
  principalId String?
  productId   String?
  productName String
  brand       String?
  qty         Decimal? @db.Decimal(14, 2)
  unit        String?
  price       Decimal? @db.Decimal(14, 2)
  value       Decimal? @db.Decimal(14, 2)

  lead      Lead       @relation(fields: [leadId], references: [id])
  principal Principal? @relation(fields: [principalId], references: [id])
  product   Product?   @relation(fields: [productId], references: [id])

  @@index([leadId])
  @@index([principalId])
  @@index([productId])
}

model LeadActivity {
  id     String   @id @default(cuid())
  leadId String
  date   DateTime @default(now())
  note   String

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
}

// ============================================================
// 6. ORDERS & PAYMENTS
// ============================================================
model SalesOrder {
  id                   String        @id @default(cuid())
  tenantId             String
  code                 String // human-facing SO number
  customerId           String
  salespersonId        String
  createdById          String? // who raised the order
  date                 DateTime      @default(now())
  status               OrderStatus   @default(Created)
  total                Decimal       @default(0) @db.Decimal(14, 2)
  isUrgent             Boolean       @default(false)
  paymentTerms         String?
  advanceAmount        Decimal?      @db.Decimal(14, 2)
  advanceRef           String?
  deliveryMode         DeliveryMode?
  deliveryAddress      String?
  expectedDelivery     DateTime?
  transporterName      String?
  lrNumber             String?
  deliveryInstructions String?
  cancelReason         String?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  customer      Customer             @relation(fields: [customerId], references: [id])
  salesperson   User                 @relation(fields: [salespersonId], references: [id])
  createdBy     User?                @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items         SalesOrderItem[]
  statusHistory OrderStatusHistory[]
  projections   Projection[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([customerId])
  @@index([salespersonId])
}

model SalesOrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  qty       Decimal @db.Decimal(14, 2)
  price     Decimal @db.Decimal(14, 2)
  unit      String?

  order   SalesOrder @relation(fields: [orderId], references: [id])
  product Product    @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  note        String?
  changedById String
  at          DateTime    @default(now())

  order     SalesOrder @relation(fields: [orderId], references: [id])
  changedBy User       @relation(fields: [changedById], references: [id])

  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  refNo         String? // human-facing payment reference
  customerId    String? // nullable: manual payment not linked to a customer record
  customerName  String? // fallback label when customerId is null
  salespersonId String? // "ownerId" on the frontend
  invoiceNo     String?
  invoiceDate   DateTime?
  amount        Decimal       @db.Decimal(14, 2)
  received      Decimal       @default(0) @db.Decimal(14, 2)
  pending       Decimal?      @db.Decimal(14, 2)
  dueDate       DateTime?
  agingDays     Int?
  payZone       PayZone?
  delayReason   String?
  nextFollowUp  DateTime?
  mail1         Boolean       @default(false)
  mail2         Boolean       @default(false)
  mail3         Boolean       @default(false)
  mail4         Boolean       @default(false)
  status        PaymentStatus @default(Pending)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  customer    Customer?         @relation(fields: [customerId], references: [id])
  salesperson User?             @relation("PaymentOwner", fields: [salespersonId], references: [id])
  followups   PaymentFollowup[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId])
  @@index([customerId])
  @@index([salespersonId])
  @@index([status])
}

model PaymentFollowup {
  id               String    @id @default(cuid())
  paymentId        String
  date             DateTime  @default(now())
  note             String
  nextFollowupDate DateTime?

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

// ============================================================
// 7. CROSS-CUTTING
// ============================================================
model FollowUp {
  id            String     @id @default(cuid())
  tenantId      String
  entityType    EntityType // "kind" on the frontend (projection|lead|payment)
  entityId      String // "targetId" on the frontend
  salespersonId String // "ownerId" on the frontend
  title         String?
  subtitle      String?
  amount        Decimal?   @db.Decimal(14, 2)
  dueDate       DateTime
  done          Boolean    @default(false)
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  salesperson User   @relation(fields: [salespersonId], references: [id])

  @@index([tenantId])
  @@index([salespersonId])
  @@index([dueDate, done])
}

model Activity {
  id         String     @id @default(cuid())
  tenantId   String
  entityType EntityType
  entityId   String
  userId     String
  type       String
  note       String?
  at         DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
}

// Free-text remarks/notes attached to a Projection, Lead, Payment, Order or
// Customer. Mirrors the frontend RemarkEntry[] embedded on those records, but
// normalized so remarks are queryable and audit-friendly.
model Remark {
  id         String     @id @default(cuid())
  tenantId   String
  entityType EntityType
  entityId   String
  userId     String? // author (may be null for system-generated notes)
  text       String
  at         DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
}

// A reporting month frozen for edits. Presence of the row IS the lock; unlock
// deletes it, so there is no "locked: false" state to disagree with itself.
// Enforced in ProjectionsService.update — the Data page toggle it replaces was
// local React state that reset on reload.
model PeriodLock {
  id         String   @id @default(cuid())
  tenantId   String
  period     String // YYYY-MM, matching Projection.period
  reason     String?
  lockedById String
  lockedAt   DateTime @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  lockedBy User   @relation(fields: [lockedById], references: [id])

  @@unique([tenantId, period])
  @@index([tenantId])
}

model Notification {
  id       String           @id @default(cuid())
  tenantId String
  userId   String
  type     NotificationType
  title    String
  body     String?
  read     Boolean          @default(false)
  at       DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId, read])
}

model Attachment {
  id           String     @id @default(cuid())
  tenantId     String
  entityType   EntityType
  entityId     String
  s3Key        String
  fileName     String
  size         Int
  uploadedById String
  createdAt    DateTime   @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String
  userId   String?
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entity, entityId])
}

model ImportJob {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  status    String   @default("pending")
  total     Int      @default(0)
  errors    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ============================================================
// 8. PLATFORM LAYER (operator-side — NOT tenant-scoped, NO tenant RLS)
// PlatformUser + PlatformAuditLog are deliberately kept OUT of the tenant
// `User` table so tenant RLS never touches them. Access = super-admin console
// only; the tenant app role (greatsales_app) is REVOKED on these (see migration).
// ============================================================
model PlatformUser {
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  passwordHash     String
  role             PlatformRole @default(Support)
  active           Boolean      @default(true)
  twoFactorEnabled Boolean      @default(false)
  twoFactorSecret  String?
  lastIp           String?
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  auditLogs      PlatformAuditLog[]
  managedTenants Tenant[]

  @@index([deletedAt])
}

model PlatformAuditLog {
  id             String   @id @default(cuid())
  platformUserId String?
  action         String // e.g. "tenant.suspend", "tenant.impersonate"
  targetType     String // "Tenant" | "PlatformUser" | ...
  targetId       String?
  tenantId       String? // which tenant was affected (if any)
  metadata       Json?
  ip             String?
  at             DateTime @default(now())

  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id])

  @@index([platformUserId])
  @@index([targetType, targetId])
  @@index([tenantId])
}

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique // e.g. "new-dashboard"
  description    String?
  enabledGlobal  Boolean  @default(false)
  rolloutPercent Int      @default(0) // 0-100 gradual rollout
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenantOverrides TenantFeatureFlag[]
}

model TenantFeatureFlag {
  id            String  @id @default(cuid())
  tenantId      String
  featureFlagId String
  enabled       Boolean

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id])

  @@unique([tenantId, featureFlagId])
  @@index([tenantId])
  @@index([featureFlagId])
}
