{
  "name": "GreatSales",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "graph": "graphify extract . --code-only && graphify cluster-only . --no-label",
    "graph:update": "graphify update .",
    "analyze:pages": "node scripts/comprehensive-page-analyzer.mjs",
    "analyze:questionnaire": "node scripts/deep-questionnaire-audit.js",
    "staging:up": "docker compose -f docker-compose.staging.yml up -d --build",
    "staging:down": "docker compose -f docker-compose.staging.yml down",
    "staging:test": "node scripts/test-staging-docker.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.10",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@expo/metro-runtime": "6.1.2",
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  }
}
