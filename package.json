{
  "name": "GreatSales",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "graph": "graphify extract . --code-only && graphify cluster-only . --no-label",
    "graph:update": "graphify update .",
    "staging:up": "docker compose -f docker-compose.staging.yml up -d --build",
    "staging:down": "docker compose -f docker-compose.staging.yml down",
    "facts": "node scripts/facts.mjs",
    "parity": "node scripts/facts.mjs --parity",
    "smoke": "node scripts/smoke.mjs",
    "wiring": "node scripts/check-wiring.mjs",
    "db-wiring": "node scripts/check-db-wiring.mjs",
    "contract": "node scripts/check-contract.mjs",
    "wired": "node scripts/wired.mjs",
    "design": "node scripts/check-design.mjs",
    "verify": "node scripts/check-wiring.mjs && node scripts/check-design.mjs && pnpm --filter web lint && node scripts/smoke.mjs && node scripts/check-contract.mjs --strict && pnpm --filter api test && pnpm --filter web test",
    "test:e2e": "playwright test",
    "test:e2e:qa": "playwright test tests/e2e/qa",
    "test:e2e:ui": "playwright test --ui",
    "db:deploy:test": "node scripts/migrate-test-db.mjs",
    "db:backup": "pnpm --filter @greatsales/db db:backup",
    "db:clear-data": "pnpm --filter @greatsales/db db:clear-data",
    "db:restore": "pnpm --filter @greatsales/db db:restore",
    "db:export-excel": "pnpm --filter @greatsales/db db:export-excel",
    "db:provision": "pnpm --filter @greatsales/db db:provision",
    "share": "node scripts/share.mjs",
    "box": "node scripts/box.mjs",
    "deploy:aws": "node scripts/deploy-aws.mjs",
    "domain:cutover": "node scripts/cutover-domain.mjs",
    "icons": "node scripts/make-icons.mjs && node apps/mobilev2/scripts/make-icons.mjs",
    "design:setup": "node tools/penpot-to-code/setup.mjs",
    "design:code": "npx --yes tsx tools/penpot-to-code/render.mjs",
    "design:all": "npx --yes tsx tools/penpot-to-code/build-all.mjs",
    "backup:drill": "node scripts/backup-drill.mjs",
    "apk": "pnpm --filter @greatsales/mobilev2 exec npx eas build --platform android --profile preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.7.4",
    "turbo": "^2.10.10",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@expo/metro-runtime": "6.1.2",
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  }
}
