# Dependency directories
**/node_modules
**/.pnpm-store

# Build outputs & caches
**/dist
**/.turbo
**/.next
**/.cache
**/.expo
**/.tsbuildinfo
*.tsbuildinfo

# IDE & Editor files
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Git
.git
.gitignore

# Environment & local files
#
# The leading-dot patterns below MUST be **-prefixed. A bare `.env*` matches
# only the build-context root, so `apps/api/.env` was copied into the API image
# and its development JWT secrets and database URL shipped to production —
# visible in the container's own boot log as "injected env (9) from
# apps/api/.env". Secrets reach a container through the runtime environment,
# never through a layer.
**/.env
**/.env.*
**/*.pem

# Test & coverage
**/coverage
**/.nyc_output

# Temp & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
scratch
graphify-out
