# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
# NOT .env.test.local only — jest loads `.env.test`, so that real file must be
# ignored too while `.env.test.example` stays committed.
.env.test
.env.test.local
.env.production.local

# Testing
coverage
test-results/
playwright-report/
tests/e2e/.auth/

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Graphify (generated code-knowledge-graph; rebuild with `pnpm graph`)
graphify-out/

# Real-data seed datasets — NOT committed.
# These hold a real company's records (417 customers, 141 payments, named
# contacts with mobile numbers, extracted verbatim). Committing tenant data is
# forbidden by checklists/07-SECURITY.md G.3.9, and git history is forever.
# packages/db/prisma/dataset.ts explains how to obtain them; `db:seed` uses
# synthetic fixtures and needs none of this.
packages/db/prisma/promech-data.json
packages/db/prisma/poc-v6-data.json

# Local database backups — never commit these (can contain real data)
backups/

# Attachments written by the local storage driver (development only).
.storage/

# Image tarballs staged for deploy. A deploy that fails between `docker save`
# and the upload leaves a ~260MB file sitting in the repo root.
images.tar
images.tar.gz

# Penpot -> code: both regenerate from the Penpot file in seconds (pnpm design:all)
design-dumps/
design-reference/generated/
