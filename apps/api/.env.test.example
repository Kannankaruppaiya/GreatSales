# =============================================================================
# GreatSales API — TEST environment  (copy to `apps/api/.env.test`)
# =============================================================================
# Loaded in preference to .env whenever NODE_ENV=test, which is what jest sets.
# See apps/api/src/load-env.ts.
#
# WHY THIS FILE EXISTS
# -----------------------------------------------------------------------------
# Every API suite RESEEDS, and the seed TRUNCATEs every table. Pointed at the
# development database, one `pnpm --filter api test` destroys whatever real
# data was seeded there — which is exactly what happened on 2026-08-25 to the
# Promech dataset.
#
# So tests get their own database. Two independent things enforce it:
#   1. this file, loaded first under NODE_ENV=test, and
#   2. reseedTestDatabase(), which REFUSES to run unless the resolved database
#      name ends in "_test".
#
# Create the database once:
#   docker exec greatsales-postgres createdb -U greatsales greatsales_test
#   DIRECT_URL="postgresql://greatsales:greatsales@localhost:5433/greatsales_test" \
#     pnpm --filter @greatsales/db db:deploy
# =============================================================================

NODE_ENV=test
PORT=3002

# DATABASE_URL = the RLS-bound role the API runs as (cannot TRUNCATE).
# DIRECT_URL   = the OWNER role, used for migrations AND by the reseed helper.
# Both MUST name the same *_test database.
DATABASE_URL="postgresql://greatsales_app:greatsales_app@localhost:5433/greatsales_test?schema=public"
DIRECT_URL="postgresql://greatsales:greatsales@localhost:5433/greatsales_test?schema=public"

# Test-only values. Never reused anywhere else.
JWT_ACCESS_SECRET="test-access-secret-not-for-any-real-environment"
JWT_REFRESH_SECRET="test-refresh-secret-not-for-any-real-environment"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

CORS_ORIGIN="*"
TRUST_PROXY="false"
SWAGGER_ENABLED="false"
LOG_LEVEL="error"
