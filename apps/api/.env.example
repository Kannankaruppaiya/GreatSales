# =============================================================================
# GreatSales API — environment template  (copy to `apps/api/.env`)
# =============================================================================
# The authoritative contract is apps/api/src/config/env.ts. If you add a
# variable there, add it here. If it is not in that schema, the API must not
# read it.
#
# Validate any candidate file without booting the app:
#     pnpm --filter api env:check
#     pnpm --filter api env:check ../../.env.production --as production
#
# The values below are DEVELOPMENT defaults for the local Docker stack
# (docker-compose.yml: postgres on :5433, redis on :6380). They are not
# secrets and must never be reused in staging or production.
# =============================================================================

NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Database — TWO ROLES, ON PURPOSE
# -----------------------------------------------------------------------------
# DATABASE_URL  = greatsales_app  — the RLS-BOUND runtime role. The API uses
#                 ONLY this. It must be non-superuser and NOBYPASSRLS;
#                 PrismaService refuses to boot otherwise.
# DIRECT_URL    = greatsales      — the OWNER role, for `prisma migrate` and
#                 seeds. The running API does not need it, which is why it is
#                 optional here. See packages/db/.env.example.
#
# In production these MUST differ — the env contract rejects a boot where they
# are equal, because that means the API is running as the owner and every RLS
# policy is bypassed.
DATABASE_URL="postgresql://greatsales_app:greatsales_app@localhost:5433/greatsales?schema=public"
DIRECT_URL="postgresql://greatsales:greatsales@localhost:5433/greatsales?schema=public"

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Dev values only. Production requires >= 32 characters AND the two secrets to
# be different — an identical pair lets an access token be replayed as a
# refresh token. Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-not-for-any-real-environment"
JWT_REFRESH_SECRET="dev-refresh-secret-not-for-any-real-environment"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# -----------------------------------------------------------------------------
# CORS / origins
# -----------------------------------------------------------------------------
# "*" is a DEVELOPMENT-ONLY convenience: credentialed CORS forbids a wildcard,
# and the API refuses to start with it when NODE_ENV is not development.
#
# CORS_ORIGIN         exact origins, comma-separated
# CORS_ORIGIN_SUFFIX  domain suffix for subdomain-per-tenant deployments, e.g.
#                     ".app.greatsales.io" — matched on the parsed hostname and
#                     https only, so a new tenant needs no redeploy.
CORS_ORIGIN="*"
CORS_ORIGIN_SUFFIX=""

# The domain tenants are subdomains of, e.g. "app.greatsales.io". The API
# resolves the tenant from the request Host by stripping this suffix, so a user
# never types a tenant id. Empty = subdomain tenancy off (local dev).
APP_BASE_DOMAIN=""

# -----------------------------------------------------------------------------
# Proxy
# -----------------------------------------------------------------------------
# Express `trust proxy`. "false" is correct only when nothing sits in front of
# the API. Behind a load balancer, leaving this false makes req.ip the proxy's
# address: every client then shares ONE rate-limit bucket and User.lastIp
# records the proxy. Production refuses "false". Use the hop count, e.g. "1".
TRUST_PROXY="false"

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
# OpenAPI explorer at /api/docs. Off by default; production refuses "true".
SWAGGER_ENABLED="true"

# error | warn | info | debug | verbose
LOG_LEVEL="debug"

# Error tracking. Leave unset to disable.
# SENTRY_DSN=""

# Redis. Optional in every environment TODAY because no API code consumes it
# yet — see the DECISION note in src/config/env.ts. It becomes required in
# production when the rate limiter moves off in-process storage (the current
# limit is PER INSTANCE) or when background jobs land.
REDIS_URL="redis://localhost:6380"

# -----------------------------------------------------------------------------
# Attachments. "local" writes under STORAGE_LOCAL_DIR and is for a developer
# machine only: files on one box's disk are invisible to a second API instance
# and gone at the next deploy. Production refuses anything but "s3" (env.ts).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
# Required when STORAGE_DRIVER="s3".
# S3_BUCKET="greatsales-attachments"
# S3_REGION="ap-south-1"
# Only for a local S3 stand-in (MinIO, LocalStack). Unset in production.
# S3_ENDPOINT="http://localhost:9000"
