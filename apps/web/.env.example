# GreatSales Web Client Environment Variables
# IMPORTANT: Only public configuration can be prefixed with VITE_.
# DO NOT store sensitive private keys, tokens, or database passwords in this file.

# Same-origin by design: the refresh token is an httpOnly cookie, so the API
# must be first-party. Dev reaches it through the Vite proxy (vite.config.ts),
# staging through its reverse proxy. Only override for a non-browser client.
VITE_API_URL=/api/v1
VITE_APP_ENV=development
VITE_APP_NAME="GreatSales PRO"

# Login-form prefill (DEVELOPMENT ONLY).
# Forced empty in production builds by src/lib/config.ts, so these never ship.
# Values below match the deterministic dev seed (pnpm --filter @greatsales/db db:seed);
# for the POC dataset (db:seed:poc) use tenant_greatsales / admin@greatsales.local.
VITE_DEMO_TENANT_ID=tenant_acme
VITE_DEMO_EMAIL=admin@acme.test
VITE_DEMO_PASSWORD=Passw0rd!
VITE_DEMO_PASSWORD_STAFF=Passw0rd!
