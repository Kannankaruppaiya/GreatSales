{
  "expo": {
    "name": "GreatSales",
    "slug": "greatsales",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "greatsales",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "primaryColor": "#17A45E",
    "android": {
      "package": "com.greatsales.crm",
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.greatsales.crm",
      "buildNumber": "2",
      "supportsTablet": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GreatSales uses your location only when you tap \"Pin current location\", to save where a customer is.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#17A45E",
          "imageWidth": 200
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "apiBaseUrl": "https://greatworksapp.in/api/v1",
      "eas": {
        "projectId": "d58801d6-32a3-4bf5-a4d4-3985f9859016"
      }
    },
    "owner": "kannankaruppaiya"
  }
}
