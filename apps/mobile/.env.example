# GreatSales mobile (Expo) — env template. Copy to `.env` and fill in.
# Only EXPO_PUBLIC_* vars reach the app (process.env.EXPO_PUBLIC_*).
# These are inlined into the client bundle — never put real secrets here.

# API base URL. LEAVE UNSET for local development: src/gs/api.ts derives the
# host from the Metro server on a phone and from window.location on web, so it
# survives a DHCP change or a Wi-Fi/Ethernet switch without an edit here. A LAN
# IP written into this file goes stale and then every request fails with
# "could not reach the server", with nothing in the logs to say why.
#
# Set it only for a host the app cannot infer:
#   Staging / production:  https://api.example.com/api/v1
#   Android emulator:      http://10.0.2.2:3001/api/v1
# EXPO_PUBLIC_API_URL="https://api.example.com/api/v1"

# development | staging | production
EXPO_PUBLIC_ENV="development"
