# GreatSales mobile (Expo) — env template. Copy to `.env` and fill in.
# Only EXPO_PUBLIC_* vars reach the app (process.env.EXPO_PUBLIC_*).
# These are inlined into the client bundle — never put real secrets here.

# API base URL. On a physical phone use the dev machine's LAN IP (not localhost).
#   Physical phone (same Wi-Fi): http://<PC-LAN-IP>:3000/api/v1
#   Android emulator:            http://10.0.2.2:3000/api/v1
#   iOS simulator / web:         http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL="http://<PC-LAN-IP>:3000/api/v1"

# development | staging | production
EXPO_PUBLIC_ENV="development"
