{
  "expo": {
    "name": "GreatSales",
    "slug": "greatsales",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "greatsales",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.greatsales.crm",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#059669",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GreatSales uses your location only when you tap \"Pin live location\", to save where a customer is so it can be shared with a driver.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://18-130-99-225.sslip.io/api/v1",
      "router": {},
      "eas": {
        "projectId": "d58801d6-32a3-4bf5-a4d4-3985f9859016"
      }
    },
    "primaryColor": "#059669",
    "ios": {
      "bundleIdentifier": "com.greatsales.crm",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "owner": "kannankaruppaiya"
  }
}
